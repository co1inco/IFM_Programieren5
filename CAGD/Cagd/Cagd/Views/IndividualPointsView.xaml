<UserControl x:Class="Cagd.Views.IndividualPointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance cagd:IndividualPointsViewModel}"
             xmlns:local="clr-namespace:Cagd.Views"
             xmlns:cagd="clr-namespace:Cagd"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <GroupBox>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Points List -->
            <GroupBox Grid.Row="0" Header="Control Points" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Points}">
                        
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
            
            <!-- Actions Toolbar -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,0">
                <Button Content="+ Point" Command="{Binding AddPointCommand}" Margin="0,0,6,6" Padding="10,4"/>
                <Button Content="- Point" Command="{Binding RemovePointCommand}" Margin="0,0,6,6" Padding="10,4"/>
                <Button Content="Clear" Command="{Binding ClearPointsCommand}" Margin="0,0,6,6" Padding="10,4"/>
            </WrapPanel>
        </Grid>
    </GroupBox>
</UserControl>
