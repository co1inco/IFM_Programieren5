<UserControl x:Class="Cagd.Views.BezieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Cagd.Views"
             xmlns:cagd="clr-namespace:Cagd"
             d:DataContext="{d:DesignInstance cagd:BezierViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    
    <GroupBox Header="Bezier curve">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <CheckBox Grid.Column="0"
                      Margin="5"
                      HorizontalAlignment="Stretch"
                      IsChecked="{Binding ShowSegment}" >
                
            </CheckBox>
            
            <Slider Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Margin="5"
                    Minimum="0"
                    Maximum="1"
                    IsSnapToTickEnabled="False"
                    IsMoveToPointEnabled="True"
                    TickFrequency="0.1"
                    Value="{Binding CurveParameter}"/>
            
            <TextBox Grid.Column="2"
                     Margin="5"
                     Width="30" 
                     Text="{Binding CurveParameter, StringFormat={}{0:F2}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>    
    </GroupBox>
    
</UserControl>
