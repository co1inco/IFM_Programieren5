<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cagd="clr-namespace:Cagd"
                    xmlns:views="clr-namespace:Cagd.Views">
    
    <DataTemplate DataType="{x:Type cagd:ControlPointViewModel}">
        <views:ControlPointView/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type cagd:IndividualPointsViewModel}">
        <views:IndividualPointsView/>
    </DataTemplate>
    
</ResourceDictionary>