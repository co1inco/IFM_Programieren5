<Window x:Class="Cagd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cagd"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="CAGD - Polygon Train &amp; Curves" Height="600" Width="950">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Views/DrawableResources.xaml"/>
                <ResourceDictionary Source="Views/ControlResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Sidebar: Control Polygon & Points Editor -->
        <Border Grid.Column="0" Background="#F4F4F6" BorderBrush="#DDDDDE" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Polygon Train" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                    <TextBlock Text="Edit control points in real-time" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Actions Toolbar -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button Content="Load OBJ" Command="{Binding LoadCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="+ Point" Command="{Binding AddPointCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="- Point" Command="{Binding RemovePointCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="Reset View" Command="{Binding ResetViewCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="Center Object" Command="{Binding CenterObjectCommand}" Margin="0,0,6,6" Padding="10,4"/>
                </WrapPanel>

                <!-- Points List -->
                <GroupBox Grid.Row="2" Header="Control Points" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PolygonTrain.Points}">
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <ContentControl Grid.Row="3" Content="{Binding IndividualPoints}"/>
                
                <!-- Footer / Status Info -->
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock Text="{Binding PolygonTrain.Count, StringFormat='Total Vertices: {0}'}" FontSize="12" Foreground="#666"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Right Viewport: Canvas -->
        <Viewbox Grid.Column="1" Stretch="Uniform" Margin="10">
            <ItemsControl Background="#E8ECEF"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Drawables}"
                          ItemContainerStyle="{StaticResource DrawableContainerStyle}">
                
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Name="Canvas"
                                Width="{Binding CanvasResolution.X}" 
                                Height="{Binding CanvasResolution.Y}">
                            <!-- <b:Interaction.Triggers> -->
                            <!--     <b:EventTrigger EventName="MouseMove"> -->
                            <!--         <b:InvokeCommandAction Command="{Binding MoveCanvasCommand}" -->
                            <!--                                PassEventArgsToCommand="True"/> -->
                            <!--     </b:EventTrigger> -->
                            <!-- </b:Interaction.Triggers> -->
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform
                                        ScaleX="{Binding CanvasScale.X}"
                                        ScaleY="{Binding CanvasScale.Y}"/>
                                    <TranslateTransform
                                        X="{Binding CanvasTransform.X}"
                                        Y="{Binding CanvasTransform.Y}"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Canvas.RenderTransformOrigin>
                                <Binding Path="CanvasTransform"/>
                            </Canvas.RenderTransformOrigin>
                        </Canvas>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Viewbox>
    </Grid>
</Window>
