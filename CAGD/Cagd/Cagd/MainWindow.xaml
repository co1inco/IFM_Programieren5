<Window x:Class="Cagd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cagd"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>
    
    <Window.Resources>
        <local:SubtractConverter x:Key="Sub"/>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        
        <ItemsControl Grid.Column="0" ItemsSource="{Binding BezieObject.Points}">
            
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Grid.Column="0" Margin="5" Text="{Binding X}"/>
                        <TextBox Grid.Column="1" Margin="5" Text="{Binding Y}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            
        </ItemsControl>
        
        
        
        <Viewbox Grid.Column="1" Stretch="Uniform">
            <ItemsControl Grid.Column="1" 
                          Background="Gray"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Drawables}">
                
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Width="{Binding CanvasResolution.X}" 
                                Height="{Binding CanvasResolution.Y}">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform
                                        ScaleX="{Binding CanvasScale.X}"
                                        ScaleY="{Binding CanvasScale.Y}"/>
                                    <TranslateTransform
                                        X="{Binding CanvasTransform.X}"
                                        Y="{Binding CanvasTransform.Y}"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Canvas.RenderTransformOrigin>
                                <Binding Path="CanvasTransform"/>
                            </Canvas.RenderTransformOrigin>
                        </Canvas>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Position.X}">
                            <!-- <Setter.Value> -->
                            <!--     <MultiBinding Converter="{StaticResource Sub}"> -->
                            <!--         <Binding Path="Position.X"/> -->
                            <!--         <Binding Path="Offset.X"/> -->
                            <!--     </MultiBinding> -->
                            <!-- </Setter.Value> -->
                        </Setter>
                        <Setter Property="Canvas.Top" Value="{Binding Position.Y}">
                            <!-- <Setter.Value> -->
                            <!--     <MultiBinding Converter="{StaticResource Sub}"> -->
                            <!--         <Binding Path="Position.Y"/> -->
                            <!--         <Binding Path="Offset.Y"/> -->
                            <!--     </MultiBinding> -->
                            <!-- </Setter.Value> -->
                        </Setter>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                
                <!-- <ItemsControl.ItemTemplate> -->
                <!--     <DataTemplate DataType="{x:Type local:DrawableRect}"> -->
                <!--         <Rectangle Width="{Binding Width}"  -->
                <!--                    Height="{Binding Height}"  -->
                <!--                    Fill="{Binding Color}"/> -->
                <!--     </DataTemplate> -->
                <!-- </ItemsControl.ItemTemplate> -->
                
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type local:DrawableRect}">
                        <Rectangle Width="{Binding Width}"
                                   Height="{Binding Height}"
                                   Fill="{Binding Color}"/>
                    </DataTemplate>
                
                    <DataTemplate DataType="{x:Type local:DrawablePoint}">
                        <Ellipse Width="{Binding Radius}"
                                 Height="{Binding Radius}"
                                 Fill="{Binding Color}"/>
                    </DataTemplate>
                    
                    <DataTemplate DataType="{x:Type local:DrawableLine}">
                        <Line X1="{Binding P1.X}"
                              Y1="{Binding P1.Y}"
                              X2="{Binding P2.X}"
                              Y2="{Binding P2.Y}"
                              StrokeThickness="{Binding Thickness}"
                              Stroke="{Binding Color}"/>
                    </DataTemplate>
                    
                    <!-- <DataTemplate DataType="{x:Type local:DrawableCollection}"> -->
                    <!--     <ItemsControl ItemsSource="{Binding Drawables}"> -->
                    <!-- -->
                    <!--     </ItemsControl> -->
                    <!-- </DataTemplate> -->
                    
                </ItemsControl.Resources>
            </ItemsControl>
        </Viewbox>
    </Grid>
</Window>
