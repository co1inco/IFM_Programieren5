<Window x:Class="Cagd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cagd"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="CAGD - Polygon Train &amp; Curves" Height="600" Width="950">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>
    
    <Window.Resources>
        <local:SubtractConverter x:Key="Sub"/>

        <Style x:Key="DrawableContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Position.X}"/>
            <Setter Property="Canvas.Top" Value="{Binding Position.Y}"/>
        </Style>

        <ItemsPanelTemplate x:Key="DrawableItemsPanel">
            <Canvas/>
        </ItemsPanelTemplate>

        <DataTemplate DataType="{x:Type local:DrawableRect}">
            <Rectangle Width="{Binding Width}"
                       Height="{Binding Height}"
                       Fill="{Binding Color}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DrawablePoint}">
            <Ellipse Width="{Binding Radius}"
                     Height="{Binding Radius}"
                     Fill="{Binding Color}">
                <Ellipse.RenderTransform>
                    <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type local:DrawableLine}">
            <Line X1="{Binding P1.X}"
                  Y1="{Binding P1.Y}"
                  X2="{Binding P2.X}"
                  Y2="{Binding P2.Y}"
                  StrokeThickness="{Binding Thickness}"
                  Stroke="{Binding Color}"/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type local:DrawableCollection}">
            <ItemsControl ItemsSource="{Binding Drawables}"
                          ItemsPanel="{StaticResource DrawableItemsPanel}"
                          ItemContainerStyle="{StaticResource DrawableContainerStyle}"/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Sidebar: Control Polygon & Points Editor -->
        <Border Grid.Column="0" Background="#F4F4F6" BorderBrush="#DDDDDE" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Polygon Train" FontSize="18" FontWeight="Bold" Foreground="#222"/>
                    <TextBlock Text="Edit control points in real-time" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Actions Toolbar -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button Content="Load OBJ" Command="{Binding LoadCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="+ Point" Command="{Binding AddPointCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="- Point" Command="{Binding RemovePointCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="Reset View" Command="{Binding ResetViewCommand}" Margin="0,0,6,6" Padding="10,4"/>
                    <Button Content="Center Object" Command="{Binding CenterObjectCommand}" Margin="0,0,6,6" Padding="10,4"/>
                </WrapPanel>

                <!-- Points List -->
                <GroupBox Grid.Row="2" Header="Control Points" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PolygonTrain.Points}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ControlPointViewModel}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#E0E4E8" CornerRadius="3" Margin="0,2,4,2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="X:" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555"/>
                                        <TextBox Grid.Column="2" Margin="2,0,4,0" Padding="3,2"
                                                 Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Grid.Column="3" Text="Y:" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555"/>
                                        <TextBox Grid.Column="4" Margin="2,0,4,0" Padding="3,2"
                                                 Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"/>

                                        <Button Grid.Column="5" Content="✕" Margin="2,0,0,0" Padding="4,1"
                                                ToolTip="Remove point"
                                                Command="{Binding DataContext.PolygonTrain.RemovePointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <!-- Footer / Status Info -->
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="{Binding PolygonTrain.Count, StringFormat='Total Vertices: {0}'}" FontSize="12" Foreground="#666"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Right Viewport: Canvas -->
        <Viewbox Grid.Column="1" Stretch="Uniform" Margin="10">
            <ItemsControl Background="#E8ECEF"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Drawables}"
                          ItemContainerStyle="{StaticResource DrawableContainerStyle}">
                
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Name="Canvas"
                                Width="{Binding CanvasResolution.X}" 
                                Height="{Binding CanvasResolution.Y}">
                            <!-- <b:Interaction.Triggers> -->
                            <!--     <b:EventTrigger EventName="MouseMove"> -->
                            <!--         <b:InvokeCommandAction Command="{Binding MoveCanvasCommand}" -->
                            <!--                                PassEventArgsToCommand="True"/> -->
                            <!--     </b:EventTrigger> -->
                            <!-- </b:Interaction.Triggers> -->
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform
                                        ScaleX="{Binding CanvasScale.X}"
                                        ScaleY="{Binding CanvasScale.Y}"/>
                                    <TranslateTransform
                                        X="{Binding CanvasTransform.X}"
                                        Y="{Binding CanvasTransform.Y}"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Canvas.RenderTransformOrigin>
                                <Binding Path="CanvasTransform"/>
                            </Canvas.RenderTransformOrigin>
                        </Canvas>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Viewbox>
    </Grid>
</Window>
